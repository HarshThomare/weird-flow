+	movzbq (in1_1), in1_1
+	movzbq (in2_0), in2_0
+	movzbq (in2_1), in2_1
+	# And computation:
+
+	# out_1 = in1_0 & in2_0
+	lea (out_1,in2_0), %r10
+	mov (%r10, in1_0), %r10b
+
+	# out_0 = in1_1
+	lea (out_0, in1_1), %r10
+	# out_0 = in2_1
+	lea (out_0,in2_1), %r10
