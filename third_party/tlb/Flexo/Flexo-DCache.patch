+	.p2align	4, 0x90
+	.type	__DualGate__2_1_xor,@function
+__DualGate__2_1_xor:                  # @__DualGate__2_1_xxx
+	call mod_ret_addr										# trigger speculation with long running task
+	# load all values
+	movzbq (in1_0), in1_0
+	movzbq (in1_1), in1_1
+	movzbq (in2_0), in2_0
+	movzbq (in2_1), in2_1
+	# xor computation:
+
+	# out_1 = in2_1 & in1_0
+	lea (out_1,in1_0), %r10
+	mov (%r10, in2_1), %r10b
+	# out_1 = in2_0 & in1_1
+	lea (out_1, in1_1), %r10
+	mov (%r10, in2_0), %r10b
+
+	# out_0 = in2_0 & in1_0
+	lea (out_0,in1_0), %r10
+	mov (%r10, in2_0), %r10b
+	# out_0 = in2_1 & in1_1
+	lea (out_0,in1_1), %r10
+	mov (%r10, in2_1), %r10b
