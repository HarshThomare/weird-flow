+    // if (control[3]) out = out | (x | y);        // OR
+    // if (control[4]) out = out | (x ^ y);        // XOR
+    // if (control[5]) out = out | (x << y);       // SHL
+    // if (control[6]) out = out | (x >> y);       // SHR
